# Copy this file to .env.local, then paste the two Google keys there.
# Live searches need the server key. Setup: docs/API_KEYS.md
# SECRET server key: enable only Places API (New) and Routes API.
GOOGLE_MAPS_API_KEY=
# Public browser key REQUIRED for the real Google Map and route playback.
# Enable only Maps JavaScript API, with website restrictions.
# This key is visible to visitors by design. Never reuse the secret server key here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional JavaScript map ID. Create your own for production; local default is DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Set both for persistent group sessions. Run database/schema.sql in Supabase first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: leave blank to use the current website address for invitations.
NEXT_PUBLIC_APP_URL=
